# Shared with the staff portal — same corpus, same model bridge
DATABASE_URL=            # Neon — SAME instance as portal (shared mksap_chunks)
OLLAMA_BASE_URL=https://llm.llmvinayminihome.uk
TEXT_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text
EMBED_MODEL_V2=mxbai-embed-large
TOP_K=8

# Standalone identity — tags this app's rows in shared usage tables.
# See migration: 0001_app_source.sql
APP_SOURCE=standalone

# Doctor triage stamp door. Safe default is closed: only the exact value "1" permits stamps.
# A production write-mint flip requires separate operational approval; do not enable by default.
TRIAGE_BOT_WRITE=
# Optional CSV of note_class values the bot may mint (default: opd). Do NOT add ot or
# discharge_summary here without an explicit Vinay write GO after lander spot-check.
# TRIAGE_BOT_WRITE_CLASSES=opd

# IPD Episode Audit (engine ipd-episode-audit/0.1). The flag gates the UI only — the worker runs
# whatever it is set to, so a cohort can be built and reviewed before anything is shown.
IPD_EPISODE_AUDIT_ENABLED=            # '1' turns on /admin/ipd-audit/episodes; anything else 404s
IPD_EPISODE_CHECKPOINT_MODEL=         # default global.anthropic.claude-haiku-4-5-20251001-v1:0
IPD_EPISODE_JUDGE_MODEL=              # default global.anthropic.claude-opus-4-6-v1
