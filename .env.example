# Shared with the staff portal — same corpus, same model bridge
DATABASE_URL=            # Neon — SAME instance as portal (shared mksap_chunks)
OLLAMA_BASE_URL=https://llm.llmvinayminihome.uk
TEXT_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text
EMBED_MODEL_V2=mxbai-embed-large
TOP_K=8

# Standalone identity — tags this app's rows in shared usage tables.
# See migration: 0001_app_source.sql
APP_SOURCE=standalone

# ── Rerank telemetry (Stage 0a) ─────────────────────────────────────────────
# Keys every patient-derived value the retrieval manifest records: the expansion input, each
# pre-rerank passage, and the rendered scorer context. HMAC-SHA-256, and REQUIRED — an unkeyed
# digest of a short clinical string is reversible by dictionary attack, so the key is the whole
# protection (PRD v2.1 §4.3).
#
# ⚠️ A PRODUCTION BUILD FAILS WITHOUT IT. next.config.mjs throws when VERCEL=1 and
# VERCEL_ENV=production and this value is empty or whitespace. Set it in Vercel Production BEFORE
# deploying. Outside production its absence is not fatal: the manifest records four explicit nulls
# and telemetry_error='hmac_key_absent', which is honest but makes every row partial.
#
# ⚠️ NOTE FOR LOCAL BUILDS: `vercel env pull` writes VERCEL=1 and VERCEL_ENV=production into
# .env.local, so the guard also fires on a local `next build` on a machine that has pulled. Set a
# throwaway value locally — it never has to match production, and rotating it only changes the
# hmac_key_version-prefixed digests, which is exactly what that prefix is for.
CDMSS_TELEMETRY_HMAC_KEY=
