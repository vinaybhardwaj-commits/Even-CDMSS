{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "buildCommand": "next build",
  "installCommand": "npm install",
  "git": { "deploymentEnabled": { "main": true } },
  "crons": [
    { "path": "/api/cron/harvest", "schedule": "0 * * * *" },
    { "path": "/api/cron/harvest-epmc", "schedule": "0 3 * * *" },
    { "path": "/api/cron/curator", "schedule": "0 5 * * 1" },
    { "path": "/api/opd-audit/worker", "schedule": "*/4 19-23 * * *" },
    { "path": "/api/learning/mine", "schedule": "0 1 * * *" },
    { "path": "/api/ccb/worker", "schedule": "*/15 18-23 * * *" },
    { "path": "/api/admin/sync-doctor-directory", "schedule": "30 4 * * *" },
    { "path": "/api/admin/refresh-doctor-metrics", "schedule": "0 4 * * *" },
    { "path": "/api/admin/opd-audit-mini-backfill?auto=1", "schedule": "*/2 * * * *" },
    { "path": "/api/admin/lab-batch?auto=1", "schedule": "*/2 * * * *" },
    { "path": "/api/admin/complexity-backfill?auto=1", "schedule": "*/2 * * * *" },
    { "path": "/api/admin/opd-audit/longitudinal-replay?auto=1", "schedule": "*/10 * * * *" }
  ]
}
