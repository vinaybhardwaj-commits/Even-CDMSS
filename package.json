{
  "name": "even-cdmss",
  "version": "2.0.0",
  "private": true,
  "description": "CAT (Clinical Analysis Tool) — standalone clinical decision support, MKSAP/StatPearls-grounded. Shares Neon corpus + Ollama with the staff portal; developed and deployed independently. Repo: Even-CDMSS.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node --import tsx scripts/architecture-check.mjs",
    "architecture:map": "node --import tsx scripts/architecture-map-gen.mjs",
    "reasoning:registry": "node scripts/reasoning-registry-gen.mjs",
    "icd:master": "node --env-file=.env.local --import tsx scripts/icd-master-gen.mjs",
    "test": "node --test --import tsx \"lib/**/__tests__/*.test.ts\"",
    "ddx:bench": "node --import tsx scripts/ddx-p0-run.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "dompurify": "^3.2.3",
    "lucide-react": "^0.383.0",
    "mermaid": "^11.4.0",
    "next": "15.5.18",
    "openai": "^4.77.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
